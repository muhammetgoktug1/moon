MONGODB_URI=mongodb://localhost:27017/moon
PORT=3000
# Dakikalık kontrol turu (varsayılan 0 = kapalı; çift kontrolcülük olmasın)
MOON_CHECKER=0
# 1 = izlenen sitelerde self-signed/iç CA sertifikaları da kabul edilir
MOON_INSECURE_TLS=0
# Dış özet ucu /api/external/summary için servis token'ı (boşsa uç kapalı)
MOON_SERVICE_TOKEN=
# Bildirim köprüsü conf yolu (gruplu WhatsApp)
MOON_NOTIFY_CONF=/data/bildirim.conf.json
# Alan adı sabitleme: MOON_DNS_OVERRIDES listesindeki adlar MOON_STATIC_IP'ye çözülür
MOON_DNS_OVERRIDES=
MOON_STATIC_IP=
